    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "clsx": "^2.1.1",
    "dockview": "^4.13.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.73.0",
    "naga-wasm": "^30.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.1.0"
