    "comments": [
      {
        "color": "#60a5fa",
        "id": "note_src",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 73,
          "w": 456
        },
        "text": "The sprite texture and its UV. The kit below samples the sprite itself (several taps), so only the texture *asset* and the UV are passed in."
      },
      {
        "color": "#fbbf24",
        "id": "note_fx",
        "position": {
          "x": 682,
          "y": 34
        },
        "size": {
          "h": 73,
          "w": 542
        },
        "text": "The **Outline + Glow kit** samples the alpha on rings around each pixel: a thin ring gives the outline, three wider rings give a stepped, smooth glow. The result is composited *behind* the sprite with straight alpha."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 1428,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 848
        },
        "text": "Splits the kit's RGBA into colour + alpha; the opacity slider only scales alpha, so the HDR glow keeps its colour."
      }
    ],
