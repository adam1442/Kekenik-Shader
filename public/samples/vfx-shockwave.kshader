    "comments": [
      {
        "color": "#60a5fa",
        "id": "note_inputs",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 762
        },
        "text": "Quad UV, the particle age in seconds (normalised age × lifetime), particle colour and the screen UV of the fragment."
      },
      {
        "color": "#4ade80",
        "id": "note_ripple",
        "position": {
          "x": 988,
          "y": 34
        },
        "size": {
          "h": 73,
          "w": 542
        },
        "text": "The **Ripple Shockwave** node: ring radius `speed × t`, gaussian envelope of the given width, `sin` ripple inside it, faded over the lifetime. *offset* is the UV displacement, *strength* the ring envelope (0…1)."
      },
      {
        "color": "#22d3ee",
        "id": "note_refract",
        "position": {
          "x": 1734,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 1460
        },
        "text": "`sceneColor(screenUV + offset × screenScale)` — the opaque texture read at a displaced coordinate. The highlight adds `ringColor × strength × glow` on the wavefront."
      },
      {
        "color": "#fbbf24",
        "id": "note_mask",
        "position": {
          "x": 1734,
          "y": 571
        },
        "size": {
          "h": 39,
          "w": 1154
        },
        "text": "`1 − smoothstep(edgeFade, 0.5, |uv − ½|)`: the quad's square border never shows. Alpha = mask × particle alpha."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 3398,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 300
        },
        "text": "Distorted scene colour with the round alpha mask."
      }
    ],
