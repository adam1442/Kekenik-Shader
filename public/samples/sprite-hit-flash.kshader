  "graph": {
    "comments": [
      {
        "color": "#60a5fa",
        "id": "note_src",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 848
        },
        "text": "Sprite fetch multiplied by the vertex colour — that is how a SpriteRenderer's *Color* field (and its alpha fade) reaches a custom shader."
      },
      {
        "color": "#fbbf24",
        "id": "note_flash",
        "position": {
          "x": 1074,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 848
        },
        "text": "**Hit Flash** (Mix): `rgb = lerp(rgb, flash, amount)`. A second node in *Add* mode adds `flash × amount × overbright` on top, giving values above 1 for bloom. Both keep alpha untouched."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 2126,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 848
        },
        "text": "Final colour and the (untouched) sprite alpha."
      }
    ],
