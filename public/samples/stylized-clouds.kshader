    "profileId": "unity.urp.unlit",
    "properties": [
      {
        "category": "Shape",
        "default": null,
        "displayName": "Cloud Noise",
        "exposed": true,
        "id": "noiseMap",
        "perInstance": false,
        "referenceName": "_CloudNoise",
        "textureDefault": "grey",
        "tooltip": "Tileable noise (grey) used for the lumps, the erosion and the shading. Linear data, wrap mode Repeat.",
        "type": "texture2D"
      },
      {
        "category": "Shape",
        "default": 0.28,
        "displayName": "Lump Height",
        "exposed": true,
        "id": "lumps",
        "max": 0.6,
        "min": 0,
        "perInstance": false,
        "referenceName": "_LumpHeight",
        "slider": true,
        "tooltip": "Vertex displacement along the normal, in object units.",
        "type": "float"
      },
      {
        "category": "Shape",
        "default": 2,
        "displayName": "Noise Tiling",
        "exposed": true,
        "id": "tiling",
        "max": 6,
        "min": 0.5,
        "perInstance": false,
        "referenceName": "_NoiseTiling",
        "slider": true,
        "tooltip": "Noise repeats around the mesh (bigger = smaller billows).",
        "type": "float"
      },
      {
        "category": "Soft Edge",
        "default": 0.35,
        "displayName": "Edge Erosion",
        "exposed": true,
        "id": "erosion",
        "max": 1,
        "min": 0,
        "perInstance": false,
        "referenceName": "_EdgeErosion",
        "slider": true,
        "tooltip": "How much the noise bites into the silhouette (0 = clean round edge).",
        "type": "float"
      },
      {
        "category": "Soft Edge",
        "default": 0.08,
        "displayName": "Edge Cutoff",
        "exposed": true,
        "id": "cutoff",
        "max": 0.6,
        "min": 0,
        "perInstance": false,
        "referenceName": "_EdgeCutoff",
        "slider": true,
        "tooltip": "Facing ratio (N·V) below which the cloud is fully transparent.",
        "type": "float"
      },
      {
        "category": "Soft Edge",
        "default": 0.4,
        "displayName": "Edge Softness",
        "exposed": true,
        "id": "softness",
        "max": 1,
        "min": 0.05,
        "perInstance": false,
        "referenceName": "_EdgeSoftness",
        "slider": true,
        "tooltip": "Width of the alpha fade at the edge.",
        "type": "float"
      },
      {
        "category": "Shading",
        "colorSpace": "srgb",
        "default": [
          1,
          0.97,
          0.92
        ],
        "displayName": "Lit Color",
        "exposed": true,
        "id": "topColor",
        "perInstance": false,
        "referenceName": "_LitColor",
        "tooltip": "Colour of the lit top (sRGB).",
        "type": "color"
      },
      {
        "category": "Shading",
        "colorSpace": "srgb",
        "default": [
          0.55,
          0.62,
          0.78
        ],
        "displayName": "Shadow Color",
        "exposed": true,
        "id": "bottomColor",
        "perInstance": false,
        "referenceName": "_ShadowColor",
        "tooltip": "Colour of the shaded underside (sRGB).",
        "type": "color"
      },
      {
        "category": "Shading",
        "default": 0.35,
        "displayName": "Shade Softness",
        "exposed": true,
        "id": "rampSoftness",
        "max": 0.7,
        "min": 0.02,
        "perInstance": false,
        "referenceName": "_ShadeSoftness",
        "slider": true,
        "tooltip": "Width of the transition between shadow and lit colour.",
        "type": "float"
      },
      {
        "category": "Shading",
        "default": 0.25,
        "displayName": "Noise Shading",
        "exposed": true,
        "id": "noiseShade",
        "max": 0.6,
        "min": 0,
        "perInstance": false,
        "referenceName": "_NoiseShading",
        "slider": true,
