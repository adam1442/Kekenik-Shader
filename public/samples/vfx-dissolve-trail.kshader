    "subgraphDefs": {
      "ks_soft_dissolve": {
        "comments": [
          {
            "color": "#fb923c",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 56,
              "w": 2378
            },
            "text": "**Soft dissolve** — the cut line is `t = amount × (1 + width) − width`, so amount 0 hides nothing and amount 1 hides everything, edge band included.\n`alpha = smoothstep(t, t+soft, noise)`; the band is `alpha × (1 − smoothstep(t+width, t+width+soft, noise))`."
          }
        ],
        "edges": {
          "alpha:out>edge:a": {
            "from": {
              "node": "alpha",
              "port": "out"
            },
            "id": "alpha:out>edge:a",
            "to": {
              "node": "edge",
              "port": "a"
            }
          },
          "alpha:out>outputs:alpha": {
            "from": {
              "node": "alpha",
              "port": "out"
            },
