    "profileId": "unity.urp.vfx-unlit",
    "properties": [
      {
        "category": "Dissolve",
        "default": null,
        "displayName": "Dissolve Noise",
        "exposed": true,
        "id": "noiseMap",
        "perInstance": false,
        "referenceName": "_DissolveNoise",
        "textureDefault": "grey",
        "tooltip": "Tileable noise (grey) that decides which parts dissolve first. Linear data, wrap mode Repeat.",
        "type": "texture2D"
      },
      {
        "category": "Dissolve",
        "default": 1.2,
        "displayName": "Age Curve",
        "exposed": true,
        "id": "ageCurve",
        "max": 3,
        "min": 0.3,
        "perInstance": false,
        "referenceName": "_AgeCurve",
        "slider": true,
        "tooltip": "Shapes the dissolve over the particle's life: below 1 = fast start, above 1 = holds, then collapses.",
        "type": "float"
      },
      {
        "category": "Dissolve",
        "default": 0.45,
        "displayName": "Tail Bias",
        "exposed": true,
        "id": "tailBias",
        "max": 1,
        "min": 0,
        "perInstance": false,
        "referenceName": "_TailBias",
        "slider": true,
        "tooltip": "How much the tail dissolves before the head (0 = pure noise, 1 = a clean wipe from the tail).",
        "type": "float"
      },
      {
        "category": "Dissolve",
        "default": 0.12,
        "displayName": "Edge Width",
        "exposed": true,
        "id": "edgeWidth",
        "max": 0.4,
        "min": 0.02,
        "perInstance": false,
        "referenceName": "_EdgeWidth",
        "slider": true,
        "tooltip": "Width of the glowing band along the cut line (noise units).",
        "type": "float"
      },
      {
        "category": "Dissolve",
        "default": 0.04,
        "displayName": "Edge Softness",
        "exposed": true,
        "id": "softness",
        "max": 0.2,
        "min": 0.005,
        "perInstance": false,
        "referenceName": "_EdgeSoftness",
        "slider": true,
        "tooltip": "Feathering of the cut line.",
        "type": "float"
      },
      {
        "category": "Noise",
        "default": 1,
