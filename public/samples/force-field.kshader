      "ks_fresnel_kit": {
        "comments": [
          {
            "color": "#22d3ee",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 56,
              "w": 1154
            },
            "text": "**Fresnel kit** — `(1 − N·V)^power × intensity`.\nThe Fresnel node gives the view-dependent term; the mask is saturated so it can drive alpha, emission or a ramp directly. Glow = colour × mask."
          }
        ],
