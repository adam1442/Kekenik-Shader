    "subgraphDefs": {
      "ks_depth_intersect": {
        "comments": [
          {
            "color": "#f87171",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 56,
              "w": 1460
            },
            "text": "**Depth intersection** — `gap = sceneEyeDepth(screenUV) − thisFragmentEyeDepth`, `fade = saturate(gap / distance)`.\nNeeds the camera depth texture (Unity URP: enable *Depth Texture* in the URP asset; Godot: `hint_depth_texture`). Use `1 − fade` for foam or intersection glow."
          }
        ],
        "edges": {
          "dmax:out>ratio:b": {
            "from": {
              "node": "dmax",
              "port": "out"
            },
            "id": "dmax:out>ratio:b",
            "to": {
              "node": "ratio",
              "port": "b"
            }
          },
          "fade:out>outputs:fade": {
            "from": {
              "node": "fade",
              "port": "out"
            },
            "id": "fade:out>outputs:fade",
            "to": {
              "node": "outputs",
              "port": "fade"
            }
          },
          "gap:out>outputs:gap": {
            "from": {
              "node": "gap",
              "port": "out"
            },
            "id": "gap:out>outputs:gap",
            "to": {
              "node": "outputs",
              "port": "gap"
            }
          },
          "gap:out>ratio:a": {
            "from": {
              "node": "gap",
              "port": "out"
            },
