{
  "embeddedAssets": {
    "assets": [
      {
        "dataBase64": "",
        "id": "sample.stylized-water.ripples",
        "mime": "image/png",
        "name": "water-ripples.png"
      },
      {
        "dataBase64": "",
        "id": "sample.stylized-water.flow",
