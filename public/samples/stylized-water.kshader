    "subgraphDefs": {
      "ks_depth_intersect": {
        "comments": [
          {
            "color": "#f87171",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 56,
              "w": 1460
            },
            "text": "**Depth intersection** — `gap = sceneEyeDepth(screenUV) − thisFragmentEyeDepth`, `fade = saturate(gap / distance)`.\nNeeds the camera depth texture (Unity URP: enable *Depth Texture* in the URP asset; Godot: `hint_depth_texture`). Use `1 − fade` for foam or intersection glow."
          }
        ],
        "edges": {
          "dmax:out>ratio:b": {
            "from": {
              "node": "dmax",
              "port": "out"
            },
            "id": "dmax:out>ratio:b",
            "to": {
              "node": "ratio",
              "port": "b"
            }
          },
          "fade:out>outputs:fade": {
            "from": {
              "node": "fade",
              "port": "out"
            },
            "id": "fade:out>outputs:fade",
            "to": {
              "node": "outputs",
              "port": "fade"
            }
          },
          "gap:out>outputs:gap": {
            "from": {
              "node": "gap",
              "port": "out"
            },
            "id": "gap:out>outputs:gap",
            "to": {
              "node": "outputs",
              "port": "gap"
            }
          },
          "gap:out>ratio:a": {
            "from": {
              "node": "gap",
              "port": "out"
            },
            "id": "gap:out>ratio:a",
            "to": {
              "node": "ratio",
              "port": "a"
            }
          },
          "inputs:distance>dmax:a": {
            "from": {
              "node": "inputs",
              "port": "distance"
            },
            "id": "inputs:distance>dmax:a",
            "to": {
              "node": "dmax",
              "port": "a"
            }
          },
          "ratio:out>fade:in": {
            "from": {
              "node": "ratio",
              "port": "out"
            },
            "id": "ratio:out>fade:in",
            "to": {
              "node": "fade",
              "port": "in"
            }
          },
          "sd:eye>gap:a": {
            "from": {
              "node": "sd",
              "port": "eye"
            },
            "id": "sd:eye>gap:a",
            "to": {
              "node": "gap",
              "port": "a"
            }
          },
          "sp:eyeDepth>gap:b": {
            "from": {
              "node": "sp",
              "port": "eyeDepth"
            },
            "id": "sp:eyeDepth>gap:b",
            "to": {
              "node": "gap",
              "port": "b"
            }
          },
          "sp:normalized>sd:uv": {
            "from": {
              "node": "sp",
              "port": "normalized"
            },
            "id": "sp:normalized>sd:uv",
            "to": {
              "node": "sd",
              "port": "uv"
            }
          }
        },
        "groups": [
          {
            "color": "#f87171",
            "id": "grp_body",
            "nodeIds": [
              "sp",
              "sd",
              "gap",
              "dmax",
              "ratio",
              "fade"
            ],
            "rect": {
              "h": 462,
              "w": 1504,
              "x": 300,
              "y": 0
            },
            "title": "Depth Intersection"
          }
        ],
        "id": "ks_depth_intersect",
        "inputs": [
          {
            "default": 0.5,
            "id": "distance",
            "name": "Distance",
            "tooltip": "World-space reach of the intersection band.",
            "type": "float"
          }
        ],
