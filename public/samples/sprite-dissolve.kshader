    "comments": [
      {
        "color": "#60a5fa",
        "id": "note_src",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 542
        },
        "text": "Plain sprite fetch. Its alpha is multiplied with the dissolve mask later, so the transparent pixels stay transparent."
      },
      {
        "color": "#a78bfa",
        "id": "note_pattern",
        "position": {
          "x": 768,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 1680
        },
        "text": "Noise is sampled with scaled UV, then blended towards the V coordinate by **Direction Bias**: `pattern = lerp(noise, v, bias)`. A pure gradient dissolves as a clean sweep; some noise keeps it organic."
      },
      {
        "color": "#fb923c",
        "id": "note_cut",
        "position": {
          "x": 2652,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 542
        },
        "text": "The **Soft Dissolve** kit converts *pattern + amount* into a feathered alpha mask and a thin edge band (the burn)."
      },
      {
        "color": "#f87171",
        "id": "note_comp",
        "position": {
          "x": 3398,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 848
        },
        "text": "`colour = sprite + edge × edge colour` (HDR, so it glows) and `alpha = sprite alpha × dissolve alpha`."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 4450,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 300
        },
        "text": "Colour and alpha of the burning sprite."
      }
    ],
