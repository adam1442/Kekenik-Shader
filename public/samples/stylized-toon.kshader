    "settings": {},
    "subgraphDefs": {
      "ks_fresnel_kit": {
        "comments": [
          {
            "color": "#22d3ee",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 56,
              "w": 1154
            },
            "text": "**Fresnel kit** — `(1 − N·V)^power × intensity`.\nThe Fresnel node gives the view-dependent term; the mask is saturated so it can drive alpha, emission or a ramp directly. Glow = colour × mask."
          }
        ],
        "edges": {
          "fres:out>scale:a": {
            "from": {
              "node": "fres",
              "port": "out"
            },
            "id": "fres:out>scale:a",
            "to": {
              "node": "scale",
              "port": "a"
            }
          },
          "inputs:color>tint:a": {
            "from": {
              "node": "inputs",
              "port": "color"
            },
            "id": "inputs:color>tint:a",
            "to": {
              "node": "tint",
              "port": "a"
            }
          },
          "inputs:intensity>scale:b": {
