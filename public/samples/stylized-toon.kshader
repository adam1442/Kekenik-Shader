              "node": "inputs",
              "port": "intensity"
            },
            "id": "inputs:intensity>scale:b",
            "to": {
              "node": "scale",
              "port": "b"
            }
          },
          "inputs:normal>fres:normal": {
            "from": {
              "node": "inputs",
              "port": "normal"
            },
            "id": "inputs:normal>fres:normal",
            "to": {
              "node": "fres",
              "port": "normal"
            }
          },
          "inputs:power>fres:power": {
