  "graph": {
    "comments": [
      {
        "color": "#60a5fa",
        "id": "note_geo",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 762
        },
        "text": "World normal, view direction and the **tangent** (the brushing direction). The light direction parameter is normalised here."
      },
      {
        "color": "#4ade80",
        "id": "note_brush",
        "position": {
          "x": 988,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 2684
        },
        "text": "Noise sampled at `(u × length, v × density)` — very stretched along U, very fine along V — gives parallel scratches. The value tints the metal slightly and shifts smoothness by `(n − ½) × contrast`."
      },
      {
        "color": "#22d3ee",
        "id": "note_spec",
        "position": {
          "x": 3876,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 2684
        },
        "text": "Two **Anisotropic Highlight** kits with opposite shifts: a tight primary and a wider secondary (exponent × ⅓) tinted with the metal colour. Both are masked by `saturate(N·L)` so the unlit side stays dark."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 6764,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 542
        },
        "text": "Fully metallic base with streak-varied smoothness; the anisotropic highlight is added as emission."
      }
    ],
