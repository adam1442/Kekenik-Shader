    "settings": {},
    "subgraphDefs": {
      "ks_height_blend": {
        "comments": [
          {
            "color": "#4ade80",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 56,
              "w": 1154
            },
            "text": "**Height blend** — `blend = smoothstep(½ − s, ½ + s, coverage + (½ − height) × depth)`.\nLow areas of the base height get a bonus, so moss / snow / dust fills crevices before it climbs the ridges."
          }
        ],
        "edges": {
          "blend:out>outputs:blend": {
            "from": {
              "node": "blend",
              "port": "out"
            },
            "id": "blend:out>outputs:blend",
