      "ks_triplanar": {
        "comments": [
          {
            "color": "#4ade80",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 158,
              "w": 300
            },
            "text": "**Triplanar** — samples the texture on the YZ, XZ and XY planes and blends by `|n|^sharpness` (normalised). No UVs needed, so rocks and terrain never stretch.\nUses explicit LOD-free sampling; for normal maps use the Triplanar Normal node (Whiteout blend) next to this kit."
          }
        ],
        "edges": {
          "inputs:normal>tp:normal": {
            "from": {
              "node": "inputs",
              "port": "normal"
            },
            "id": "inputs:normal>tp:normal",
            "to": {
