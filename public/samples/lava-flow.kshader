      "ks_flow_sample": {
        "comments": [
          {
            "color": "#22d3ee",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 90,
              "w": 848
            },
            "text": "**Flow map** — Flow Map node returns two UV sets A/B offset by `flow × strength × phase` with phases half a cycle apart, plus the blend weight `|2·phaseA − 1|`.\nWe sample the texture at A and B and `lerp` by that weight; each layer is invisible exactly when it restarts, which hides the pop."
          }
        ],
        "edges": {
