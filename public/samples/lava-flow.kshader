    "settings": {},
    "subgraphDefs": {
      "ks_color_ramp3": {
        "comments": [
          {
            "color": "#fb923c",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 73,
              "w": 848
            },
            "text": "**Color ramp** — `lerp(lerp(cold, mid, smoothstep(0, ½, t)), hot, smoothstep(½, 1, t))`.\nThe colours stay in the caller's colour space (HDR values keep their intensity, so a hot stop above 1 blooms). Use it instead of a gradient texture to keep a shader texture-free."
          }
        ],
        "edges": {
          "inputs:cold>l1:a": {
            "from": {
              "node": "inputs",
              "port": "cold"
            },
            "id": "inputs:cold>l1:a",
            "to": {
              "node": "l1",
              "port": "a"
            }
          },
          "inputs:hot>l2:b": {
            "from": {
              "node": "inputs",
              "port": "hot"
            },
            "id": "inputs:hot>l2:b",
            "to": {
              "node": "l2",
              "port": "b"
            }
          },
          "inputs:mid>l1:b": {
            "from": {
              "node": "inputs",
              "port": "mid"
            },
            "id": "inputs:mid>l1:b",
            "to": {
              "node": "l1",
              "port": "b"
            }
          },
          "inputs:t>s1:in": {
            "from": {
              "node": "inputs",
              "port": "t"
            },
            "id": "inputs:t>s1:in",
            "to": {
              "node": "s1",
              "port": "in"
            }
          },
          "inputs:t>s2:in": {
            "from": {
              "node": "inputs",
              "port": "t"
            },
            "id": "inputs:t>s2:in",
            "to": {
              "node": "s2",
              "port": "in"
            }
          },
          "l1:out>l2:a": {
            "from": {
              "node": "l1",
              "port": "out"
            },
            "id": "l1:out>l2:a",
            "to": {
              "node": "l2",
              "port": "a"
            }
          },
          "l2:out>outputs:color": {
            "from": {
              "node": "l2",
              "port": "out"
            },
            "id": "l2:out>outputs:color",
            "to": {
              "node": "outputs",
              "port": "color"
            }
          },
          "s1:out>l1:t": {
            "from": {
              "node": "s1",
              "port": "out"
            },
            "id": "s1:out>l1:t",
            "to": {
              "node": "l1",
              "port": "t"
            }
          },
          "s2:out>l2:t": {
            "from": {
              "node": "s2",
              "port": "out"
            },
            "id": "s2:out>l2:t",
            "to": {
              "node": "l2",
              "port": "t"
            }
          }
        },
        "groups": [
          {
            "color": "#fb923c",
            "id": "grp_body",
            "nodeIds": [
              "s1",
              "s2",
              "l1",
              "l2"
            ],
            "rect": {
              "h": 467,
              "w": 892,
              "x": 300,
              "y": 0
            },
            "title": "Color Ramp (3 stops)"
          }
        ],
        "id": "ks_color_ramp3",
        "inputs": [
          {
            "default": 0.5,
            "id": "t",
            "name": "Value",
            "tooltip": "Ramp position, 0 (cold) … 1 (hot).",
            "type": "float"
          },
          {
            "default": [
              0.1,
              0,
              0
            ],
            "id": "cold",
            "name": "Cold",
            "tooltip": "Colour at 0.",
            "type": "color"
          },
          {
            "default": [
              1,
              0.3,
              0
            ],
            "id": "mid",
            "name": "Mid",
            "tooltip": "Colour at 0.5.",
            "type": "color"
          },
          {
            "default": [
              1,
              0.9,
              0.4
            ],
            "id": "hot",
            "name": "Hot",
