    "subgraphDefs": {
      "ks_palette_ramp": {
        "comments": [
          {
            "color": "#f472b6",
            "id": "note_body",
            "position": {
              "x": 322,
              "y": 34
            },
            "size": {
              "h": 56,
              "w": 1766
            },
            "text": "**Palette ramp** — `u = value × (w−1)/w + 0.5/w`, `v = (row + 0.5)/rows`: both land on texel centres, so neighbouring rows never bleed and the ends of the ramp stay clean.\nSampled with explicit LOD 0 (no mip mixing of rows)."
          }
        ],
        "edges": {
          "half:out>u:b": {
            "from": {
              "node": "half",
              "port": "out"
            },
            "id": "half:out>u:b",
            "to": {
              "node": "u",
              "port": "b"
            }
          },
          "inputs:palette>row:a": {
