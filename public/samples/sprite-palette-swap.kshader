    "comments": [
      {
        "color": "#60a5fa",
        "id": "note_src",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 542
        },
        "text": "The sprite stores *indices* as grey levels (shadow / body / light / highlight), not final colours."
      },
      {
        "color": "#4ade80",
        "id": "note_index",
        "position": {
          "x": 768,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 1374
        },
        "text": "Grey `v` → index `round(v × 3)` → ramp position `index / 3`. This lands exactly on the four colour stops of every palette, so edges and filtering can never produce in-between colours."
      },
      {
        "color": "#f472b6",
        "id": "note_pal",
        "position": {
          "x": 2346,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 848
        },
        "text": "Two **Palette Ramp** lookups share the same index; `Blend` cross-fades the resulting colours. Both rows are read on texel centres, so neighbouring palettes never bleed."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 3398,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 848
        },
        "text": "Recoloured RGB with the original sprite alpha (hard pixel edges stay hard)."
      }
    ],
