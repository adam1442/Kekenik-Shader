      },
      {
        "category": "Relief",
        "default": 2.5,
        "displayName": "Relief Strength",
        "exposed": true,
        "id": "strength",
        "max": 6,
        "min": -6,
        "perInstance": false,
        "referenceName": "_ReliefStrength",
        "slider": true,
        "tooltip": "Bump height. Negative values invert the relief (dark = high); 0 = flat.",
        "type": "float"
      },
      {
        "category": "Relief",
        "default": 1.4,
        "displayName": "Height Contrast",
        "exposed": true,
        "id": "contrast",
        "max": 4,
        "min": 0.2,
        "perInstance": false,
        "referenceName": "_HeightContrast",
        "slider": true,
        "tooltip": "Contrast of the luminance before it becomes height: higher = deeper grooves.",
        "type": "float"
      },
      {
        "category": "Relief",
        "default": 1,
        "displayName": "Detail Scale",
        "exposed": true,
        "id": "heightScale",
        "max": 4,
        "min": 0.25,
        "perInstance": false,
        "referenceName": "_DetailScale",
        "slider": true,
        "tooltip": "Scales the sampling distance of the slope: higher = broader, softer relief.",
        "type": "float"
      },
      {
        "category": "Debug",
        "default": false,
        "displayName": "Show Normals",
        "exposed": true,
        "id": "showNormals",
        "perInstance": false,
