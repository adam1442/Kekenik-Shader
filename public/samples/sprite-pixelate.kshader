    "comments": [
      {
        "color": "#4ade80",
        "id": "note_grid",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 848
        },
        "text": "The **Pixel Snap** kit moves every UV to the centre of its grid cell: `uv' = (floor(uv × res) + 0.5) / res`. All screen pixels inside one cell then read the *same* texel."
      },
      {
        "color": "#60a5fa",
        "id": "note_tex",
        "position": {
          "x": 1074,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 848
        },
        "text": "Sprite fetch at the snapped UV, then **Posterize** limits each channel to *Color Steps* levels (round mode keeps pure black and white)."
      },
      {
        "color": "#fb923c",
        "id": "note_alpha",
        "position": {
          "x": 1074,
          "y": 532
        },
        "size": {
          "h": 56,
          "w": 542
        },
        "text": "`alpha = step(threshold, a)` — partial alpha (from filtering or the source art) is snapped to 0 or 1, so the silhouette is made of whole pixels."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 2126,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 848
        },
        "text": "Posterized colour with hard alpha."
      }
    ],
