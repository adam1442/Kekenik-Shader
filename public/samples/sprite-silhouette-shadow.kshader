    "properties": [
      {
        "category": "Sprite",
        "default": null,
        "displayName": "Sprite Texture",
        "exposed": true,
        "id": "locked_sprite_texture",
        "perInstance": false,
        "referenceName": "_MainTex",
        "textureDefault": "white",
        "tooltip": "The sprite itself. Bound automatically by the SpriteRenderer (Unity) / the node's texture (Godot); locked, not exported as a uniform.",
        "type": "texture2D"
      },
      {
        "category": "Shadow",
        "colorSpace": "srgb",
        "default": [
          0.04,
          0.03,
          0.1
        ],
        "displayName": "Shadow Color",
        "exposed": true,
        "id": "shadowColor",
        "perInstance": false,
        "referenceName": "_ShadowColor",
        "tooltip": "Colour of the shadow (sRGB).",
        "type": "color"
      },
      {
        "category": "Shadow",
        "default": 0.6,
        "displayName": "Shadow Opacity",
        "exposed": true,
        "id": "shadowOpacity",
        "max": 1,
        "min": 0,
        "perInstance": false,
        "referenceName": "_ShadowOpacity",
        "slider": true,
        "tooltip": "Maximum opacity of the shadow.",
        "type": "float"
      },
      {
        "category": "Shadow",
        "default": [
          0.05,
          -0.06
        ],
        "displayName": "Shadow Offset",
        "exposed": true,
        "id": "offset",
        "perInstance": false,
        "referenceName": "_ShadowOffset",
        "tooltip": "Shadow position relative to the sprite, in UV units (+x right, +y up).",
        "type": "vec2"
      },
      {
        "category": "Shadow",
        "default": 0.012,
        "displayName": "Shadow Blur",
        "exposed": true,
        "id": "blur",
        "max": 0.04,
        "min": 0,
        "perInstance": false,
        "referenceName": "_ShadowBlur",
        "slider": true,
        "tooltip": "Radius of the 5-tap blur in UV units (0 = hard shadow).",
        "type": "float"
      },
      {
        "category": "Shadow",
        "default": 0.55,
        "displayName": "Flatten",
        "exposed": true,
        "id": "flatten",
        "max": 1,
        "min": 0.2,
        "perInstance": false,
        "referenceName": "_Flatten",
        "slider": true,
        "tooltip": "Vertical scale of the shadow around the Ground Line: 1 = unchanged, lower = squashed onto the floor.",
        "type": "float"
      },
      {
        "category": "Shadow",
        "default": 0.2,
        "displayName": "Ground Line",
        "exposed": true,
        "id": "ground",
        "max": 1,
        "min": 0,
        "perInstance": false,
        "referenceName": "_GroundLine",
        "slider": true,
