{
  "format": "kshader",
  "generator": "Kekenik Shader",
  "graph": {
    "comments": [
      {
        "color": "#60a5fa",
        "id": "note_geo",
        "position": {
          "x": 22,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 1068
        },
        "text": "World normal and view direction give `N·V`, the angle that shifts the interference colour. UV + time feed the thickness pattern."
      },
      {
        "color": "#4ade80",
        "id": "note_thick",
        "position": {
          "x": 1294,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 2072
        },
        "text": "A slowly drifting 3-octave fbm (`uv + t × drift`) is remapped between *Thickness Min* and *Max*. Real soap films have exactly this kind of flowing thickness variation."
      },
      {
        "color": "#f472b6",
        "id": "note_film",
        "position": {
          "x": 3570,
          "y": 34
        },
        "size": {
          "h": 56,
          "w": 542
        },
        "text": "The **Thin Film** subgraph turns thickness, IOR and `N·V` into an interference tint — open it to see the optical-path maths."
      },
      {
        "color": "#fb923c",
        "id": "note_mix",
        "position": {
          "x": 4316,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 1154
        },
        "text": "Base colour = `lerp(baseTone, film, strength)`. A cubic rim `(1 − N·V)³` adds a soft emissive edge in the film colour."
      },
      {
        "color": "#a78bfa",
        "id": "note_out",
        "position": {
          "x": 5674,
          "y": 34
        },
        "size": {
          "h": 39,
          "w": 542
        },
        "text": "Metallic, glossy surface tinted by the film; rim emission on top."
      }
    ],
